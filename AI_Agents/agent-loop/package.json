{
  "name": "blast-agent-loop",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone agentic @playwright/cli loop — identical behavior on local, cloud VM, or GitHub Actions.",
  "type": "commonjs",
  "scripts": {
    "start": "tsx agent-loop.ts",
    "explore": "tsx agent-loop.ts",
    "generate": "tsx generate.ts",
    "phase:explore": "tsx explore.ts",
    "phase:approve": "tsx approve.ts",
    "phase:testcase": "tsx testcase.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "setup:cli": "npm i -g @playwright/cli && npx playwright install --with-deps chromium"
  },
  "dependencies": {
    "openai": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
